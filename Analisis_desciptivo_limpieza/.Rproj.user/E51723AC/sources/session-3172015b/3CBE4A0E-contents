###########---------------------------------------#############################.
###########---------- 1. JUNTAR LAS BASES --------#############################.  
###########---------------------------------------#############################.
#- install.packages("psych")
#- install.packages("ggpplot")

#----- Paquetes 
library(psych)
library(ggplot2)

# Carga de base original, con menos artistas famosos.
data <- read.csv("CLEANED_Spotify_artist_info.csv",
                 stringsAsFactors = FALSE)

# Carga de base featured con más artistas famosos.
featured <- read.csv("CLEANED_featured_Spotify_artist_info2.csv",
                     stringsAsFactors = FALSE)

# Revisión inicial
dim(data); dim(featured)
names(data); names(featured)
head(data);head(featured)

# Variables comunes de interés para modelado.
columnas_comunes <- c(
  "ids",
  "names",
  "popularity",
  "followers",
  "genres",
  "first_release",
  "last_release",
  "num_releases",
  "num_tracks",
  "monthly_listeners"
)

###########---------------------------------------#############################.
###########------ DEPURACION BASE FEATURED -------#############################.  
###########---------------------------------------#############################.

# Decisión:
# La base featured puede contiene varias filas por artista.
# Se conserva una única observación por artista, en este caso la última y evitar duplicados.

featured$dates <- as.Date(featured$dates) # Convertir fecha

featured <- featured[order(featured$ids, featured$dates), ] # Ordenar por artista y fecha

# Conservar la última observación por artista
featured_unique <- featured[!duplicated(featured$ids, fromLast = TRUE), ]

# Comprobación
dim(featured)
dim(featured_unique)

sum(duplicated(featured_unique$ids))

###########---------------------------------------#############################.
###########------ SELECCIONAR COLUMNAS COMUNES ---#############################.
###########---------------------------------------#############################.

data_base <- data[, columnas_comunes]

featured_base <- featured_unique[, columnas_comunes]

# Comprobar que tienen exactamente las mismas columnas
names(data_base);names(featured_base)

identical(names(data_base), names(featured_base))

###########---------------------------------------#############################.
###########------ HOMOGENEIZAR TIPOS -------------#############################.
###########---------------------------------------#############################.

# Forzamos a ser numericas las categoricas
vars_numericas <- c(
  "popularity",
  "followers",
  "num_releases",
  "num_tracks",
  "monthly_listeners"
)
str(vars_numericas)

data_base[, vars_numericas] <- lapply(
  data_base[, vars_numericas],
  as.numeric
)

featured_base[, vars_numericas] <- lapply(
  featured_base[, vars_numericas],
  as.numeric
)

###########---------------------------------------#############################.
###########------ ELIMINAR REPETIDOS -------------#############################.
###########---------------------------------------#############################.

featured_nuevos <- featured_base[
  !featured_base$ids %in% data_base$ids,
]

dim(featured_nuevos)

###########---------------------------------------#############################.
###########------ UNIR BASES HOMOGENEAS ----------#############################.
###########---------------------------------------#############################.

data_base$fuente <- "base_original"
featured_nuevos$fuente <- "base_featured"

base_homogenea <- rbind(
  data_base,
  featured_nuevos
)

# Comprobaciones finales
dim(base_homogenea)

names(base_homogenea)

table(base_homogenea$fuente)

sum(duplicated(base_homogenea$ids))
sum(duplicated(base_homogenea$names))

# Hay 11 duplicados por nombre

nombres_duplicados <- base_homogenea$names[
  duplicated(base_homogenea$names) |
    duplicated(base_homogenea$names, fromLast = TRUE)
]

base_homogenea[
  base_homogenea$names %in% nombres_duplicados,
  c("ids", "names", "popularity", "followers", "monthly_listeners", "fuente")
]

# Ordenar para conservar el registro con mayor monthly_listeners por nombre
base_homogenea <- base_homogenea[
  order(base_homogenea$names, -base_homogenea$monthly_listeners),
]
# Eliminar duplicados por nombre conservando el primero
base_homogenea <- base_homogenea[
  !duplicated(base_homogenea$names),
]
# Reordenar filas
base_homogenea <- base_homogenea[
  order(base_homogenea$fuente, base_homogenea$names),
]

# Comprobación después
dim(base_homogenea)
sum(duplicated(base_homogenea$ids)); sum(duplicated(base_homogenea$names))
table(base_homogenea$fuente)

###########---------------------------------------#############################.
###########------ ELIMINAR ARTISTAS REPETIDOS ----#############################.  
###########---------------------------------------#############################.

# Decisión:
# Se incorporan solo artistas de featured que no estén ya en la base original.

# Justificación:
# El objetivo es enriquecer la muestra con casos nuevos, no duplicar artistas.
# Duplicar artistas alteraría la distribución y podría sesgar el entrenamiento.

featured_nuevos <- featured_base[
  !featured_base$ids %in% data_base$ids,
]

dim(featured_nuevos)

# Marcar fuente de procedencia
data_base$fuente <- "base_original"
featured_nuevos$fuente <- "base_featured"

# Unión final
data_ampliada <- rbind(data_base, featured_nuevos)

# Comprobaciones
dim(data_ampliada)
table(data_ampliada$fuente)

sum(duplicated(data_ampliada$ids))
sum(duplicated(data_ampliada$names))

##########---------------------------------------#############################.
###########------ REVISION VALORES IMPLAUSIBLES --#############################.
###########---------------------------------------#############################.

# Base sobre la que se trabaja
base_revision <- base_homogenea
vars_revision <- c(
  "popularity",
  "followers",
  "first_release",
  "last_release",
  "num_releases",
  "num_tracks",
  "monthly_listeners"
)
# Comprobación general de estructura
str(base_revision)
psych::describe(base_revision[,vars_revision])

# Hay un problema con first release: hay mínimos de 0 en fecha, por lo que estos casos se eliminan
# Comprobar cuántos casos hay
sum(base_homogenea$first_release == 0, na.rm = TRUE) # Solo hay 1

# Eliminar casos
base_homogenea <- base_homogenea[
  is.na(base_homogenea$first_release) |
    base_homogenea$first_release != 0,
]

# Comprobación posterior
sum(base_homogenea$first_release == 0, na.rm = TRUE)
dim(base_homogenea)
head(base_homogenea)

# Análisis de valores perdidos:
na_por_variable <- colSums(is.na(base_homogenea)); na_por_variable # 0 Na


###########---------------------------------------#############################.
###########-------- CALCULO INDICE DEMANDA -------#############################.  
###########---------------------------------------#############################.

vars_indice <- c(
  "followers",
  "popularity",
  "monthly_listeners"
)
# Descriptivos generales
psych::describe(base_homogenea[, vars_indice])

# Histogramas
par(mfrow = c(2, 3))

hist(
  base_homogenea$followers,
  main = "Followers",
  xlab = "Followers",
  col = "yellow"
)

hist(
  base_homogenea$popularity,
  main = "Popularity",
  xlab = "Popularity",
  col = "yellow"
)

hist(
  base_homogenea$monthly_listeners,
  main = "Monthly listeners",
  xlab = "Monthly listeners",
  col = "yellow"
)

par(mfrow = c(1, 1))

# Grandes asimetrias en followers y popularity, se tranforman logaritmicamente:

base_homogenea$log_followers <- log10(base_homogenea$followers + 1)

base_homogenea$log_monthly_listeners <- log10(
  base_homogenea$monthly_listeners + 1
)

# Descriptivos tras transformación
psych::describe(
  base_homogenea[, c(
    "log_followers",
    "popularity",
    "log_monthly_listeners"
  )]
)

# Histogramas tras transformación
par(mfrow = c(1, 3))

hist(
  base_homogenea$log_followers,
  main = "Log followers",
  xlab = "log10(followers + 1)",
  col = "lightyellow"
)

hist(
  base_homogenea$popularity,
  main = "Popularity",
  xlab = "Popularity",
  col = "lightyellow"
)

hist(
  base_homogenea$log_monthly_listeners,
  main = "Log monthly listeners",
  xlab = "log10(monthly listeners + 1)",
  col = "lightyellow"
)

par(mfrow = c(1, 1))

# Normalización de variables:
base_homogenea$z_monthly_listeners <- as.numeric(scale(base_homogenea$log_monthly_listeners))

base_homogenea$z_followers <- as.numeric(scale(base_homogenea$log_followers))

base_homogenea$z_popularity <- as.numeric(scale(base_homogenea$popularity))

base_homogenea$indice_demanda_digital <- rowMeans(
  base_homogenea[, c(
    "z_monthly_listeners",
    "z_followers",
    "z_popularity"
  )],
  na.rm = TRUE
)

# Comprobación del índice
psych::describe(base_homogenea$indice_demanda_digital)

summary(base_homogenea$indice_demanda_digital)

hist(
  base_homogenea$indice_demanda_digital,
  main = "Índice de demanda digital",
  xlab = "Índice",
  col = "lightgreen"
)

# Correlaciones e cada variable para saber si apuntan al mismo constructo:
cor(
  base_homogenea[, c(
    "log_monthly_listeners",
    "log_followers",
    "popularity"
  )],
  use = "complete.obs"
)
psych::describe(base_homogenea$indice_demanda_digital)


###########---------------------------------------#############################.
###########------ VARIABLE CRITERIO DEMANDA ------#############################.
###########---------------------------------------#############################.

# Decisión:
# Se crea una variable criterio categórica de demanda digital con tres niveles:
# demanda_baja, demanda_media y demanda_alta.

# Justificación:
# El índice de demanda digital permite ordenar a los artistas según su presencia
# digital. Para el aprendizaje supervisado, se transforma este índice continuo en
# una variable categórica. La categoría demanda_alta exige estar en el tramo
# superior del índice y además tener popularity >= 60, reforzando la validez
# conceptual de la clase alta.

p50_indice <- quantile(
  base_homogenea$indice_demanda_digital,
  0.50,
  na.rm = TRUE
)

p85_indice <- quantile(
  base_homogenea$indice_demanda_digital,
  0.85,
  na.rm = TRUE
)


base_homogenea$nivel_demanda_digital <- ifelse(
  base_homogenea$indice_demanda_digital >= p85_indice &
    base_homogenea$popularity >= 60,
  "demanda_alta",
  ifelse(
    base_homogenea$indice_demanda_digital >= p50_indice,
    "demanda_media",
    "demanda_baja"
  )
)

base_homogenea$nivel_demanda_digital <- factor(
  base_homogenea$nivel_demanda_digital,
  levels = c(
    "demanda_baja",
    "demanda_media",
    "demanda_alta"
  )
)

# Distribución de la variable criterio
table(base_homogenea$nivel_demanda_digital)

round(
  prop.table(table(base_homogenea$nivel_demanda_digital)) * 100,
  2
)

# Tabla de frecuencias
tabla_demanda <- table(base_homogenea$nivel_demanda_digital)

# Proporciones en porcentaje
prop_demanda <- round(prop.table(tabla_demanda) * 100, 2)

# Gráfico con colores introducidos a mano
barplot(
  prop_demanda,
  main = "Distribución del nivel de demanda digital",
  ylab = "Porcentaje",
  xlab = "Nivel de demanda digital",
  ylim = c(0, 60),
  col = c("lightyellow", "lightblue", "plum")
)

# Añadir porcentajes encima de las barras
text(
  x = c(0.7, 1.9, 3.1),
  y = prop_demanda + 2,
  labels = paste0(prop_demanda, "%")
)
###########---------------------------------------#############################.
###########------ GUARDAR BASE FINAL -------------#############################.
###########---------------------------------------#############################.

# Decisión:
# Se guarda la base depurada con el índice de demanda digital y la variable
# criterio final.

# Justificación:
# Guardar esta versión permite separar la fase de construcción de variables de
# la fase posterior de modelado supervisado, asegurando reproducibilidad.

write.csv(
  base_homogenea,
  "base_procesada.csv",
  row.names = FALSE
)